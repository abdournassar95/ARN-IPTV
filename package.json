{
  "name": "arn-iptv-pro",
  "productName": "ARN IPTV Pro",
  "version": "2.6.0",
  "description": "منصة البث الفضائي العربي الحي (ARN IPTV Pro) — شركة ARN Technology وتطوير وبرمجة عبده رجب نصار © 2026",
  "author": "عبده رجب نصار — شركة ARN Technology",
  "license": "Proprietary",
  "main": "electron-main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist-server/server.cjs --external:vite --external:electron",
    "build": "vite build && npm run build:server",
    "preview": "vite preview",
    "clean": "rm -rf dist release server.js",
    "lint": "tsc --noEmit",
    "electron:start": "electron electron-main.cjs",
    "electron:pack": "vite build && electron-builder --dir",
    "electron:dist": "vite build && electron-builder --win nsis --x64",
    "electron:portable": "vite build && electron-builder --win portable --x64",
    "build:all": "vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@vitejs/plugin-react": "^6.1.1",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-cache": "^5.1.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.arntechnology.iptvpro",
    "productName": "ARN IPTV Pro",
    "copyright": "Copyright © 2026 ARN Technology — عبده رجب نصار",
    "npmRebuild": false,
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/assets/icons/app_icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ARN IPTV Pro",
      "artifactName": "ARN_IPTV_Pro_Setup_v${version}.${ext}"
    }
  }
}
